{
  "name": "street-concept-designer-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420",
    "typecheck": "tsc --noEmit",
    "build": "npm run build:wasm && vite build",
    "tauri": "tauri",
    "build:wasm": "node scripts/build-wasm.mjs",
    "benchmark:dev": "npm run build:wasm && vite --host 127.0.0.1 --port 1420",
    "benchmark:build": "npm run build:wasm && vite build --config vite.benchmark.config.ts"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "pixi.js": "8.20.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
}
